# --- Port & Client Configuration ---
# Render sets the PORT environment variable dynamically in production.
PORT=5000
# The URL of your Vercel frontend deployment (e.g., https://saipal-website.vercel.app). Used to restrict CORS for security.
CLIENT_URL=


# --- Database Configuration ---
# MongoDB connection URI (e.g. MongoDB Atlas connection string)
MONGO_URI=

# --- JWT Configuration ---
# Secret key used to sign and verify JSON Web Tokens (use a random, secure string)
JWT_SECRET=

# --- Cloudinary Configuration ---
# Cloud name, API key, API secret, and URL for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- Email Inquiry Routing Configurations ---
# Email address to route inquiries for the school division
SCHOOL_INQUIRY_EMAIL=
# Email address to route inquiries for the college division
COLLEGE_INQUIRY_EMAIL=

# --- Brevo (Sendinblue) Email SMTP Configuration ---
# Your Brevo API Key
BREVO_API_KEY=
# Sender email address registered and verified in Brevo
BREVO_FROM=mail@saipal.edu.np
